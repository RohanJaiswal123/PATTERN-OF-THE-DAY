import java.util.*;

public class Main {

    static int binarySearch(int[] a, int target) {
        int l = 0, r = a.length - 1;

        while (l <= r) {
            int mid = l + (r - l) / 2;

            if (a[mid] == target)
                return mid;

            if (a[mid] < target)
                l = mid + 1;
            else
                r = mid - 1;
        }

        return -1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int target = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++)
            a[i] = sc.nextInt();

        System.out.println(binarySearch(a, target));
    }
}
