public int knapsack(int[] wt, int[] val, int W, int n) {
    int[][] dp = new int[n + 1][W + 1];
    for (int[] row : dp) {
        Arrays.fill(row, -1);
    }
    return helper(wt, val, W, n, dp);
}

private int helper(int[] wt, int[] val, int W, int n, int[][] dp) {
    if (n == 0 || W == 0) return 0;
    if (dp[n][W] != -1) return dp[n][W];
    
    if (wt[n - 1] <= W) {
        return dp[n][W] = Math.max(
            val[n - 1] + helper(wt, val, W - wt[n - 1], n - 1, dp),
            helper(wt, val, W, n - 1, dp)
        );
    }
    return dp[n][W] = helper(wt, val, W, n - 1, dp);
}
