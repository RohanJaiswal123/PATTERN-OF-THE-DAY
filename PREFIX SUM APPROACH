import java.util.*;

public class Main {

    static int rangeSum(int[] a, int l, int r) {
        int[] p = new int[a.length];

        p[0] = a[0];

        for (int i = 1; i < a.length; i++)
            p[i] = p[i - 1] + a[i];

        return l == 0 ? p[r] : p[r] - p[l - 1];
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int l = sc.nextInt();
        int r = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++)
            a[i] = sc.nextInt();

        System.out.println(rangeSum(a, l, r));
    }
}
