import java.util.*;

public class Main {

    static int longest(int[] a, int k) {
        int l = 0, sum = 0, ans = 0;

        for (int r = 0; r < a.length; r++) {
            sum += a[r];

            while (sum > k)
                sum -= a[l++];

            ans = Math.max(ans, r - l + 1);
        }

        return ans;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++)
            a[i] = sc.nextInt();

        System.out.println(longest(a, k));
    }
}
